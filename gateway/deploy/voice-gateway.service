[Unit]
Description=Dictation Bridge OpenAI transcription gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dictation-bridge
Group=dictation-bridge
WorkingDirectory=/opt/dictation-bridge
ExecStart=/usr/bin/python3 -B /opt/dictation-bridge/service.py --config /etc/dictation-bridge/config.json
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/dictation-bridge/provider.env
UMask=0077
StateDirectory=dictation-bridge
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dictation-bridge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=384M
MemorySwapMax=0
CPUQuota=50%
TasksMax=48
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
